generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id    String @id @default(cuid())
  email String @unique
  name  String?
  role  String @default("CLIENT")
}

model Pet {
  id      String @id @default(cuid())
  name    String
  species String
}